{
  "id": "io.github.orcvole.semaphore",
  "manifestVersion": 2,
  "title": "Semaphore UI",
  "author": "OrcVole",
  "tagline": "Web interface for running Ansible playbooks, inventories and schedules",
  "description": "file://DESCRIPTION.md",
  "changelog": "file://CHANGELOG.md",
  "icon": "file://logo.png",
  "version": "1.0.8",
  "upstreamVersion": "2.19.8",
  "healthCheckPath": "/api/ping",
  "httpPort": 3000,
  "addons": {
    "localstorage": {},
    "postgresql": {},
    "oidc": {
      "loginRedirectUri": "/api/auth/oidc/cloudron/redirect"
    }
  },
  "optionalSso": true,
  "memoryLimit": 1073741824,
  "postInstallMessage": "file://POSTINSTALL.md",
  "tags": [
    "ansible",
    "automation",
    "devops",
    "playbooks",
    "infrastructure"
  ],
  "dockerImage": "ghcr.io/orcvole/semaphore-cloudron@sha256:ae5592265aacaafba44e1a5fbcb1c90a1acb23decfefef4be731f4a87da9edac",
  "minBoxVersion": "9.1.0",
  "website": "https://semaphoreui.com",
  "documentationUrl": "https://docs.semaphoreui.com",
  "packagerName": "OrcVole",
  "packagerUrl": "https://github.com/OrcVole/semaphore-cloudron",
  "contactEmail": "Most+github@OrcadianVole.com",
  "iconUrl": "https://raw.githubusercontent.com/OrcVole/semaphore-cloudron/main/logo.png",
  "mediaLinks": [
    "https://raw.githubusercontent.com/OrcVole/semaphore-cloudron/main/logo.png"
  ],
  "checklist": {
    "admin": {
      "message": "Get the first administrator password: open a Terminal for this app (the `>_` button) and run `cat /app/data/.initial-admin`. Sign in as `admin`, change the password, then promote your own Cloudron account to administrator from Team -> Users."
    },
    "sso": {
      "message": "Accounts that sign in through Cloudron arrive as external users and are never administrators. Promote them from Team -> Users after signing in as `admin`."
    }
  }
}
